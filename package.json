{
	"name": "@magic-spells/split-panel",
	"version": "0.2.0",
	"description": "Resizable split panel web component — draggable dividers, horizontal/vertical splits, nesting, min/max constraints, localStorage persistence, no dependencies",
	"author": "Cory Schulz",
	"license": "MIT",
	"type": "module",
	"main": "dist/split-panel.esm.js",
	"module": "dist/split-panel.esm.js",
	"unpkg": "dist/split-panel.min.js",
	"style": "dist/split-panel.min.css",
	"exports": {
		".": {
			"import": "./dist/split-panel.esm.js",
			"default": "./dist/split-panel.esm.js"
		},
		"./css": "./dist/split-panel.css",
		"./css/min": "./dist/split-panel.min.css"
	},
	"sideEffects": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/magic-spells/split-panel"
	},
	"homepage": "https://github.com/magic-spells/split-panel#readme",
	"bugs": {
		"url": "https://github.com/magic-spells/split-panel/issues"
	},
	"keywords": [
		"split-panel",
		"resizable",
		"splitter",
		"panes",
		"layout",
		"drag",
		"web-components",
		"custom-elements",
		"accessibility"
	],
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "NODE_ENV=production node scripts/build.mjs",
		"dev": "NODE_ENV=development node scripts/build.mjs",
		"lint": "eslint src/ scripts/",
		"format": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"browserslist": [
		"last 2 versions",
		"not dead",
		"not ie <= 11"
	],
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@magic-spells/vite-plugin-live-reload": "^0.1.0",
		"eslint": "^9.38.0",
		"globals": "^15.15.0",
		"lightningcss": "^1.29.3",
		"prettier": "^3.3.3",
		"terser": "^5.16.0",
		"vite": "^8.0.10"
	}
}
